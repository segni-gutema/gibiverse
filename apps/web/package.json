{
  "name": "@gibiverse/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "bash ../../scripts/ensure-shared-build.sh",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "pretest": "bash ../../scripts/ensure-shared-build.sh",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gibiverse/api-client": "workspace:*",
    "@gibiverse/shared": "workspace:*",
    "@gibiverse/ui": "workspace:*",
    "better-auth": "catalog:",
    "dompurify": "catalog:",
    "lucide-react": "catalog:",
    "mammoth": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "pdfjs-dist": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-pdf": "catalog:"
  },
  "devDependencies": {
    "@gibiverse/eslint-config": "workspace:*",
    "@gibiverse/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/dompurify": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
