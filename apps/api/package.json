{
  "name": "@gibiverse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./hc": "./src/hc.ts"
  },
  "scripts": {
    "predev": "bash ../../scripts/ensure-shared-build.sh",
    "dev": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../../.prettierignore --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"**/*.{ts,tsx}\"",
    "pretest": "bash ../../scripts/ensure-shared-build.sh",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit test/**/*.test.ts",
    "test:local": "./scripts/test-local.sh",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --output json",
    "db:push": "drizzle-kit push --output json",
    "db:seed": "tsx src/db/seed.ts",
    "db:test:start": "./scripts/test-db.sh start",
    "db:test:stop": "./scripts/test-db.sh stop",
    "db:test:status": "./scripts/test-db.sh status"
  },
  "dependencies": {
    "@gibiverse/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gibiverse/eslint-config": "workspace:*",
    "@gibiverse/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
