{
  "name": "@gibiverse/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./dist/types/index.js",
      "default": "./src/types/index.ts"
    },
    "./validation": {
      "types": "./src/validation/index.ts",
      "import": "./dist/validation/index.js",
      "default": "./src/validation/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./dist/utils/index.js",
      "default": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../../.prettierignore --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"**/*.{ts,tsx}\"",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gibiverse/eslint-config": "workspace:*",
    "@gibiverse/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
